@@ -0,0 +1,65 @@
+// Reuses the real Expo config checks from docs/propuestas/android-production/verify.test.cjs.
+// Runs only locally; the package below is a proposal, not a Play reservation or signing decision.
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const path = require('node:path');
+const { createRequire } = require('node:module');
+const { spawnSync } = require('node:child_process');
+const root = path.resolve(__dirname, '../..');
+const mobile = path.join(root, 'apps/mobile');
+const requireMobile = createRequire(path.join(mobile, 'package.json'));
+const cli = path.join(path.dirname(requireMobile.resolve('expo/package.json')), 'bin/cli');
+const profile = JSON.parse(readFileSync(path.join(mobile, 'eas.json')));
+const brand = JSON.parse(readFileSync(path.join(root, 'config/brand.json')));
+function resolveConfig(overrides = {}) {
+  return spawnSync(process.execPath, [cli, 'config', '--type', 'public', '--json'], {
+    cwd: mobile, encoding: 'utf8', timeout: 30000,
+    env: { PATH: process.env.PATH, HOME: process.env.HOME, TMPDIR: process.env.TMPDIR,
+      EXPO_NO_DOTENV: '1', EXPO_NO_TELEMETRY: '1', EXPO_OFFLINE: '1', CI: '1',
+      ...profile.build.production.env, EAS_BUILD_PLATFORM: 'android', ...overrides },
+  });
+}
+test('the isolated Android proposal resolves with the original payment scheme, permissions and Expo project', () => {
+  const result = resolveConfig();
+  assert.equal(result.status, 0, result.stderr);
+  const c = JSON.parse(result.stdout);
+  assert.equal(c.name, 'mayami');
+  assert.equal(c.android.package, 'app.mayami.marketplace'); // unconfirmed local proposal
+  assert.equal(c.scheme, brand.scheme);
+  assert.equal(c.scheme, 'kora');
+  assert.equal(c.ios.bundleIdentifier, brand.iosBundleId);
+  assert.deepEqual(c.android.permissions, ['android.permission.POST_NOTIFICATIONS']);
+  assert.deepEqual(c.android.blockedPermissions, ['android.permission.RECORD_AUDIO', 'android.permission.READ_EXTERNAL_STORAGE', 'android.permission.WRITE_EXTERNAL_STORAGE']);
+  assert.equal(c.android.predictiveBackGestureEnabled, false);
+  assert.equal(c.android.icon, './assets/images/mayami/android-icon.png');
+  assert.equal(c.extra.supportEmail, 'soporte@mayami.app');
+  assert.deepEqual(c.android.intentFilters[0].data.map(d => [d.host, d.pathPrefix]), [['mayami.app', '/p/'], ['mayami.app', '/tienda/']]);
+  assert.equal(c.owner, 'marketplacebrand');
+  assert.equal(c.extra.eas.projectId, '9f629f10-d679-4a99-9965-8a9e588afc85');
+  assert.equal(c.updates.url, 'https://u.expo.dev/9f629f10-d679-4a99-9965-8a9e588afc85');
+  assert.deepEqual(c.runtimeVersion, { policy: 'fingerprint' });
+});
+test('this source refuses preview, iOS and missing or provisional package identifiers', () => {
+  for (const env of [{ APP_VARIANT: 'preview' }, { EAS_BUILD_PLATFORM: 'ios' }, { MAYAMI_ANDROID_APPLICATION_ID: '' }, { MAYAMI_ANDROID_APPLICATION_ID: 'com.example.kora' }]) {
+    const result = resolveConfig(env);
+    assert.notEqual(result.status, 0);
+    assert.match(result.stdout + result.stderr, /exclusivo de Android production|MAYAMI_ANDROID_APPLICATION_ID/);
+  }
+});
+test('the sole store profile is an AAB proposal with only public Marketplace configuration', () => {
