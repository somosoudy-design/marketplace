diff --git a/apps/mobile/src/lib/google-auth-ports.ts b/apps/mobile/src/lib/google-auth-ports.ts
new file mode 100644
index 0000000..5281c33
--- /dev/null
+++ b/apps/mobile/src/lib/google-auth-ports.ts
@@ -0,0 +1,61 @@
+// Prepared ports. No screen imports these while Google activation is pending.
+import * as Crypto from 'expo-crypto';
+import * as WebBrowser from 'expo-web-browser';
+import { GOOGLE_AUTH_ACTIVATED, type GoogleAttempt, type GoogleAttemptStore } from '@kora/api';
+
+/** Production remains disabled until provider/policy/redirects are separately approved. */
+export const GOOGLE_ACCESS_ENABLED = GOOGLE_AUTH_ACTIVATED;
+export const GOOGLE_CALLBACK = 'kora://auth-callback' as const;
+export const GOOGLE_FLOW_PARAMETER = 'google_flow' as const;
+
+export type BrowserResult = { type: 'success'; url: string } | { type: 'cancel' };
+
+/** Exactly 32 CSPRNG bytes; no Math.random/debugger fallback. */
+export async function randomBytes(): Promise<Uint8Array> {
+  const bytes = await Crypto.getRandomBytesAsync(32);
+  if (!(bytes instanceof Uint8Array) || bytes.byteLength !== 32) throw new Error('Secure random unavailable');
+  return bytes;
+}
+
+export async function sha256Base64(value: string): Promise<string> {
+  const digest = await Crypto.digestStringAsync(Crypto.CryptoDigestAlgorithm.SHA256, value, {
+    encoding: Crypto.CryptoEncoding.BASE64,
+  });
+  if (!/^[A-Za-z0-9+/]{43}=$/.test(digest)) throw new Error('Invalid SHA-256 result');
+  return digest;
+}
+
+/** Callback validation/exchange belongs to the engine, never to a second Linking listener here. */
+export function mapBrowserResult(result: { type: string; url?: string }): BrowserResult {
+  switch (result.type) {
+    case 'success':
+      if (!result.url) throw new Error('Missing browser callback');
+      return { type: 'success', url: result.url };
+    case 'cancel':
+    case 'dismiss':
+      return { type: 'cancel' };
+    default:
+      // An unexpected native result is a failure, never successful authentication.
+      throw new Error('Unexpected browser outcome');
+  }
+}
+
+export const browser = {
+  async open(url: string, callback: string): Promise<BrowserResult> {
+    return mapBrowserResult(await WebBrowser.openAuthSessionAsync(url, callback));
+  },
+};
+
+/** Native attempts are process memory only. No AsyncStorage/SecureStore/URL material recovery. */
+export function createMemoryAttemptRepository(): GoogleAttemptStore {
+  let attempt: GoogleAttempt | null = null;
+  return {
+    read: (): GoogleAttempt | null => attempt,
+    write: (value: GoogleAttempt): void => { attempt = value; },
+    clear: (): void => { attempt = null; },
+  };
+}
+
+// Deliberately no dismissAuthSession wrapper: Android Custom Tabs may need manual close.
+// Engine cancellation invalidates the in-memory attempt and ignores its later callback.
+// Gate is evaluated by the engine before these ports are invoked; no effect runs on import.
diff --git a/apps/mobile/src/lib/google-runtime.ts b/apps/mobile/src/lib/google-runtime.ts
new file mode 100644
index 0000000..0c3b169
--- /dev/null
+++ b/apps/mobile/src/lib/google-runtime.ts
@@ -0,0 +1,41 @@
+import { createGoogleAuthRuntime, type GoogleResult } from '@kora/api';
+import * as Crypto from 'expo-crypto';
+import { Platform } from 'react-native';
+import { env } from './env';
+import { sessionStorage } from './session-storage';
+import { safeAuthReturn } from './auth-navigation';
+import { GOOGLE_ACCESS_ENABLED, browser, createMemoryAttemptRepository, randomBytes, sha256Base64 } from './google-auth-ports';
+import { createWebAttemptRepository, googleAttemptCodec } from '@kora/api';
+
+const web = Platform.OS === 'web';
+const callback = web ? 'https://mayami.app/auth/callback' : 'kora://auth-callback';
+const unavailable = { getItem: async () => null, setItem: async () => { throw new Error('Session storage unavailable'); }, removeItem: async () => { throw new Error('Session storage unavailable'); } };
+const storage = GOOGLE_ACCESS_ENABLED && web && typeof window !== 'undefined' ? window.localStorage : sessionStorage ?? unavailable;
+export const googleRuntime = createGoogleAuthRuntime({
+  enabled: GOOGLE_ACCESS_ENABLED, url: env.supabaseUrl || 'https://not-configured.invalid', anonKey: env.supabaseAnonKey || 'missing-anon-key',
+  storage, callbackBase: callback, synchronous: web,
+  attemptStore: GOOGLE_ACCESS_ENABLED && web && typeof window !== 'undefined' ? createWebAttemptRepository(window.sessionStorage, googleAttemptCodec(callback)) : createMemoryAttemptRepository(),
+  crypto: { randomBytes, sha256Base64 }, newIntentId: () => Crypto.randomUUID(), safeReturn: value => safeAuthReturn(value) ?? '/',
+  withLock: async work => {
+    if (typeof navigator === 'undefined' || !navigator.locks) throw new Error('Este navegador no puede coordinar el acceso entre pestañas.');
+    return navigator.locks.request(`mayami.auth:${new URL(env.supabaseUrl).hostname}`, work);
+  }, detectSessionInUrl: web,
+});
+
+let browserRun = 0;
+export function cancelGoogleAccess() { browserRun++; googleRuntime.google.cancel(); }
+export async function startGoogleAccess(purpose: 'register' | 'login', returnTo: string): Promise<GoogleResult | { status: 'redirecting' }> {
+  const run = ++browserRun;
+  const opened = await googleRuntime.google.begin(purpose, returnTo);
+  if (run !== browserRun) return { status: 'cancelled' };
+  if (web) { window.location.assign(opened.url); return { status: 'redirecting' }; }
+  try {
+    const result = await browser.open(opened.url, opened.callback);
+    if (run !== browserRun) return { status: 'cancelled' };
+    if (result.type === 'cancel') { cancelGoogleAccess(); return { status: 'cancelled' }; }
+    return await googleRuntime.google.complete(result.url);
+  } catch {
+    if (run !== browserRun) return { status: 'cancelled' };
+    cancelGoogleAccess(); return { status: 'failed' };
+  }
+}
