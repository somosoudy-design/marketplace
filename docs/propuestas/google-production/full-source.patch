diff --git a/apps/storefront/src/components/google-access-button.tsx b/apps/storefront/src/components/google-access-button.tsx
new file mode 100644
index 0000000..8923068
--- /dev/null
+++ b/apps/storefront/src/components/google-access-button.tsx
@@ -0,0 +1,33 @@
+'use client';
+import { useEffect, useRef, useState, useSyncExternalStore } from 'react';
+import { browser } from '@/lib/browser';
+import { useAccount } from '@/lib/providers';
+const subscribe = () => () => undefined;
+
+export function GoogleAccessButton({ purpose, returnTo, disabled, onBusyChange }: {
+  purpose: 'login' | 'register'; returnTo: string; disabled?: boolean; onBusyChange?(busy: boolean): void;
+}) {
+  const { ready, session } = useAccount();
+  const enabled = useSyncExternalStore(subscribe, () => browser().runtime.enabled, () => false);
+  const [busy, setBusy] = useState(false), [error, setError] = useState('');
+  const mounted = useRef(false), started = useRef(false), handedOff = useRef(false);
+  useEffect(() => {
+    mounted.current = true;
+    return () => { mounted.current = false; if (started.current && !handedOff.current) browser().runtime.google.cancel(); };
+  }, []);
+  if (!enabled || session) return null;
+  const pending = (value: boolean) => { setBusy(value); onBusyChange?.(value); };
+  return <div className="auth-links">
+    <button type="button" data-testid="google-access" className="button secondary" disabled={!ready || disabled || busy} onClick={async () => {
+      pending(true); started.current = true; setError('');
+      try {
+        const attempt = await browser().runtime.google.begin(purpose, returnTo);
+        if (!mounted.current) return;
+        handedOff.current = true;
+        window.location.assign(attempt.url);
+      } catch { if (mounted.current) { pending(false); setError('No pudimos continuar con Google. Revisa tu sesión e inténtalo de nuevo.'); } }
+    }}>{busy ? 'Abriendo Google…' : 'Continuar con Google'}</button>
+    {busy ? <button type="button" className="text-link" onClick={() => { browser().runtime.google.cancel(); pending(false); }}>Cancelar acceso con Google</button> : null}
+    {error ? <p className="error" role="alert">{error}</p> : null}
+  </div>;
+}
