+import { createWebAttemptRepository, googleAttemptCodec } from '@kora/api';
+
+const web = Platform.OS === 'web';
+const callback = web ? 'https://mayami.app/auth/callback' : 'kora://auth-callback';
+const unavailable = { getItem: async () => null, setItem: async () => { throw new Error('Session storage unavailable'); }, removeItem: async () => { throw new Error('Session storage unavailable'); } };
+const storage = GOOGLE_ACCESS_ENABLED && web && typeof window !== 'undefined' ? window.localStorage : sessionStorage ?? unavailable;
+export const googleRuntime = createGoogleAuthRuntime({
+  enabled: GOOGLE_ACCESS_ENABLED, url: env.supabaseUrl || 'https://not-configured.invalid', anonKey: env.supabaseAnonKey || 'missing-anon-key',
+  storage, callbackBase: callback, synchronous: web,
+  attemptStore: GOOGLE_ACCESS_ENABLED && web && typeof window !== 'undefined' ? createWebAttemptRepository(window.sessionStorage, googleAttemptCodec(callback)) : createMemoryAttemptRepository(),
+  crypto: { randomBytes, sha256Base64 }, newIntentId: () => Crypto.randomUUID(), safeReturn: value => safeAuthReturn(value) ?? '/',
