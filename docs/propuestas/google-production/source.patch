+export function cancelGoogleAccess() { browserRun++; googleRuntime.google.cancel(); }
+export async function startGoogleAccess(purpose: 'register' | 'login', returnTo: string): Promise<GoogleResult | { status: 'redirecting' }> {
+  const run = ++browserRun;
