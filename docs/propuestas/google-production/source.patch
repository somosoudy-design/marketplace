+  if (!s || typeof s.access_token !== 'string' || !s.access_token || typeof s.refresh_token !== 'string' || !s.refresh_token ||
+      s.token_type !== 'bearer' || typeof s.expires_in !== 'number' || !Number.isFinite(s.expires_in) ||
