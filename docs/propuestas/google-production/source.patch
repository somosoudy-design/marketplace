+import { useEffect, useRef, useState } from 'react';
+import { View } from 'react-native';
+import { useAuth } from '@/lib/auth';
+import { finishAuth } from '@/lib/auth-navigation';
+import { Button } from '@/components/ui/Button';
+import { Banner } from '@/components/ui/States';
+
+export function GoogleAccessButton({ purpose, returnTo }: { purpose: 'login' | 'register'; returnTo?: string }) {
+  const auth = useAuth();
+  const [error, setError] = useState('');
+  const mounted = useRef(false);
+  useEffect(() => { mounted.current = true; return () => { mounted.current = false; }; }, []);
+  if (!auth.googleEnabled) return null;
+  return <View style={{ gap: 10 }}>
+    {error ? <Banner tone="danger" body={error} /> : null}
+    <Button testID="google-access" title="Continuar con Google" variant="secondary" full loading={auth.googleBusy} onPress={async () => {
+      setError('');
+      try {
+        const result = await auth.signInWithGoogle(purpose, returnTo ?? '/');
+        if (!mounted.current) return;
+        if (result.status === 'accepted') {
+          if (await auth.claimGoogleNavigation(result, () => mounted.current)) finishAuth(result.returnTo);
+        } else if (result.status === 'uncertain') setError('No pudimos confirmar el resultado. Revisa tu cuenta antes de repetir.');
+        else if (result.status !== 'cancelled' && result.status !== 'redirecting') setError('No pudimos continuar con Google. Inténtalo de nuevo.');
+      } catch { if (mounted.current) setError('No pudimos continuar con Google. Revisa tu sesión e inténtalo de nuevo.'); }
+    }} />
+    {auth.googleBusy ? <Button title="Cancelar acceso con Google" variant="ghost" full onPress={auth.cancelGoogle} /> : null}
+  </View>;
+}
