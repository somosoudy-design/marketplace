diff --git a/apps/storefront/src/lib/category-navigation-art.ts b/apps/storefront/src/lib/category-navigation-art.ts
new file mode 100644
index 0000000..4efe8cd
--- /dev/null
+++ b/apps/storefront/src/lib/category-navigation-art.ts
@@ -0,0 +1,7 @@
+// Navigation-only matte. A different product/image keeps its original presentation.
+const technologyPhoto = '5afbabbf-0678-40ee-a5d8-540f53efe114/b1b4a794-c740-47e9-ae57-1c1e3089b80d/c6dba434-37f6-4758-91e5-a65a028c2fc2.jpg';
+export function categoryNavigationMask(slug: string, path: string | null): string | undefined {
+  return slug === 'tecnologia' && path === technologyPhoto
+    ? '/category-art/tecnologia-mask-046d5825ab82a348.png'
+    : undefined;
+}
diff --git a/tests/storefront/category-navigation-art.test.ts b/tests/storefront/category-navigation-art.test.ts
new file mode 100644
index 0000000..0ec003d
--- /dev/null
+++ b/tests/storefront/category-navigation-art.test.ts
@@ -0,0 +1,14 @@
+import { describe, expect, it } from 'vitest';
+import { categoryNavigationMask } from '../../apps/storefront/src/lib/category-navigation-art';
+const path = '5afbabbf-0678-40ee-a5d8-540f53efe114/b1b4a794-c740-47e9-ae57-1c1e3089b80d/c6dba434-37f6-4758-91e5-a65a028c2fc2.jpg';
+describe('Technology navigation matte scope', () => {
+  it('uses the scoped navigation matte only for the exact Technology photo', () => {
+    expect(categoryNavigationMask('tecnologia', path)).toBe('/category-art/tecnologia-mask-046d5825ab82a348.png');
+  });
+  it('never assigns the tablet matte to Audio or other categories', () => {
+    for (const slug of ['audio', 'odontologia', 'hogar', 'belleza']) expect(categoryNavigationMask(slug, path)).toBeUndefined();
+  });
+  it('keeps a different, missing or replaced Technology image unmasked', () => {
+    for (const image of [null, 'seller/new-tablet.jpg', path + '?changed=1', 'https://example.invalid/' + path]) expect(categoryNavigationMask('tecnologia', image)).toBeUndefined();
+  });
+});
