# =====================================================================================
# Kora (nombre provisional) — variables de entorno de ejemplo.
# Copia solo lo que necesites al lugar indicado. Nunca subas valores reales al repositorio.
# Cada app tiene además su propio .env.example (apps/mobile, apps/admin).
# =====================================================================================

# ---------- App móvil (apps/mobile/.env.local o variables de EAS) ----------
# Se empaquetan dentro de la app: SOLO valores públicos. Nunca una service role key ni secretos.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321          # emulador Android: http://10.0.2.2:54321; teléfono: IP LAN de tu equipo
EXPO_PUBLIC_SUPABASE_ANON_KEY=                           # anon/publishable key del proyecto
EXPO_PUBLIC_PANEL_URL=http://127.0.0.1:3100              # enlace "Panel de vendedor" / "Administración"

# EAS (solo en la máquina o CI que compila; no son secretos de la app)
EAS_PROJECT_ID=                                          # lo crea `eas init`
EXPO_OWNER=                                              # cuenta u organización de Expo
# APP_VARIANT lo fija cada perfil de eas.json (development | preview | production)

# ---------- Panel web (apps/admin/.env.local o variables del hosting) ----------
# También públicos: la autorización la decide la base de datos (RLS + funciones).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STORE_URL=https://kora.example.com

# ---------- Edge Functions (supabase secrets set ...) ----------
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase automáticamente.
PAYMENTS_RETURN_URL=kora://pay/result                    # a dónde vuelve el comprador tras pagar en línea
PUBLIC_FUNCTIONS_URL=                                    # opcional; por defecto <SUPABASE_URL>/functions/v1
RATES_USER_AGENT=KoraRates/1.0 (+https://kora.example.com)

# Binance Pay (requiere cuenta merchant aprobada por Binance; ver docs/SERVICIOS_EXTERNOS.md)
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
BINANCE_PAY_PUBLIC_KEY=                                  # PEM de la clave pública de Binance para verificar webhooks

# PayPal (cuenta Business; sandbox primero)
PAYPAL_ENV=sandbox                                       # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Expo Push (opcional: solo si activas "enhanced security" en Expo)
EXPO_ACCESS_TOKEN=

# ---------- Desarrollo local ----------
# tools/local-stack genera .local/keys.env con SUPABASE_URL, claves locales y DATABASE_URL.
# Las pruebas de base de datos usan por defecto postgres://postgres:postgres@127.0.0.1:54322/kora_test
