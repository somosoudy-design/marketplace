# Public values only (they ship inside the app bundle). Never put a service role key or any secret here.
# Local stack (pnpm stack:start). On an Android emulator use http://10.0.2.2:54321; on a phone, your computer's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# URL of the web panel (apps/admin) for the "Panel de vendedor" / "Administración" links.
EXPO_PUBLIC_PANEL_URL=http://127.0.0.1:3100
